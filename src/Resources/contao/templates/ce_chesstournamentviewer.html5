<?php

use Schachbulle\ContaoChesstournamentviewerBundle\Liste\Ausgabe;

?>
<?php $this->extend('block_searchable'); ?>

<?php $this->block('content'); ?>

<?php if ($this->fehler): ?>

  <p class="ctv-fehler"><?= Ausgabe::esc(sprintf($GLOBALS['TL_LANG']['ctv']['fehler'] ?? '%s', $this->fehler)) ?></p>

<?php elseif ($this->liste): ?>

  <div class="ctv" id="<?= $this->kennung ?>">

    <?php /* Alles gehoert in den Abschnitt hinein: Steht das Element in einem
             Umschlag, blendet die Stilvorlage den ganzen Abschnitt aus, wenn
             sein Reiter nicht gewaehlt ist. Stuende der Hinweis darueber,
             haenge er ueber jeder Ausgabe.

             Der Name im `data-ctv-name` ist das, was der Umschlag auf die
             Reiterlasche schreibt. */ ?>
    <section class="ctv-liste ctv-liste--<?= $this->liste['schluessel'] ?>"
             id="<?= $this->kennung ?>-<?= $this->liste['schluessel'] ?>"
             data-ctv-name="<?= Ausgabe::esc($this->reitername) ?>">

      <?php if ($this->stand): ?>
        <p class="ctv-stand"><?= Ausgabe::esc(sprintf($GLOBALS['TL_LANG']['ctv']['standTitel'] ?? 'Stand nach Runde %d', $this->stand)) ?></p>
      <?php endif; ?>

      <?php if ($this->hinweise): ?>
        <div class="ctv-hinweise">
          <?php foreach ($this->hinweise as $hinweis): ?>
            <p class="ctv-hinweis"><?= Ausgabe::esc($hinweis) ?></p>
          <?php endforeach; ?>
        </div>
      <?php endif; ?>

      <?php $this->insert($this->liste['template'], array_merge($this->liste['daten'], ['turnier' => $this->turnier])); ?>

    </section>

  </div>

<?php endif; ?>

<?php $this->endblock(); ?>
