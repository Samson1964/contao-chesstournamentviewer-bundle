<?php

/*
 * Eine Zeile der Rangliste.
 *
 * Ausgelagert, weil die Rangliste sie an zwei Stellen braucht — durchgehend
 * und innerhalb der Mannschaftsgruppen. Ein eigenes Template ist der einzige
 * Weg, das Markup nicht zu verdoppeln, ohne dass beim Überschreiben eine
 * Fassung vergessen wird.
 */

use Schachbulle\ContaoChesstournamentviewerBundle\Liste\Ausgabe;

?>
<tr>
  <td class="ctv-zahl"><?= Ausgabe::zahl($this->spieler['platz']) ?></td>
  <td><?= Ausgabe::esc(Ausgabe::name($this->spieler)) ?></td>
  <td class="ctv-zahl"><?= Ausgabe::zahl($this->spieler['twz']) ?></td>
  <td class="ctv-zahl"><?= Ausgabe::bilanz($this->spieler) ?></td>
  <td class="ctv-zahl ctv-punkte"><?= Ausgabe::punkte($this->spieler['punkte']) ?></td>
  <?php if ($this->feinwertung1): ?>
    <td class="ctv-zahl"><?= Ausgabe::punkte($this->spieler['feinwertung1']) ?></td>
  <?php endif; ?>
  <?php if ($this->feinwertung2): ?>
    <td class="ctv-zahl"><?= Ausgabe::punkte($this->spieler['feinwertung2']) ?></td>
  <?php endif; ?>
</tr>
