<?php

use Schachbulle\ContaoChesstournamentviewerBundle\Liste\Ausgabe;

$wertung = Ausgabe::wertungsname($this->turnier);
$gruppiert = (bool) $this->kaempfe;

?>
<?php foreach ($this->runden as $runde => $partien): ?>

  <h4 class="ctv-runde"><?= Ausgabe::esc(Ausgabe::runde((int) $runde)) ?></h4>

  <div class="ctv-rollbar">
    <table class="ctv-tabelle ctv-tabelle--paarungen">
      <thead>
        <tr>
          <th scope="col" class="ctv-zahl ctv-schmal" title="<?= Ausgabe::spalte($this->spalte) ?>"><?= Ausgabe::spalte('brettKurz') ?></th>
          <th scope="col" class="ctv-paarung__seite"><?= Ausgabe::spalte('weiss') ?></th>
          <th scope="col" class="ctv-zahl ctv-schmal"><?= $wertung ?></th>
          <th scope="col" class="ctv-paarung__ergebnis" title="<?= Ausgabe::spalte('ergebnis') ?>"><?= Ausgabe::spalte('ergebnisKurz') ?></th>
          <th scope="col" class="ctv-paarung__seite"><?= Ausgabe::spalte('schwarz') ?></th>
          <th scope="col" class="ctv-zahl ctv-schmal"><?= $wertung ?></th>
        </tr>
      </thead>

      <?php if ($gruppiert): ?>

        <?php /* Mannschaftsturnier: je Wettkampf eine Kopfzeile mit beiden
                 Mannschaften, darunter die Bretter dieses Wettkampfs. */ ?>
        <?php foreach ($this->kaempfe[$runde] ?? [] as $kampf): ?>
          <tbody class="ctv-gruppe">
            <tr class="ctv-gruppe__kopf<?= $kampf['spielfrei'] ? ' ctv-partie--frei' : '' ?>">
              <th scope="colgroup" colspan="6">
                <?= Ausgabe::esc($kampf['heimName']) ?>
                <?php if ($kampf['spielfrei']): ?>
                  <em>&ndash; <?= Ausgabe::wort('freilos', 'Freilos') ?></em>
                <?php else: ?>
                  &ndash; <?= Ausgabe::esc($kampf['gastName']) ?>
                  <?php if ($this->mitErgebnissen && $kampf['gespielt']): ?>
                    <span class="ctv-gruppe__ergebnis"><?= Ausgabe::punkte($kampf['brettpunkteHeim']) ?>:<?= Ausgabe::punkte($kampf['brettpunkteGast']) ?></span>
                  <?php endif; ?>
                <?php endif; ?>
              </th>
            </tr>
            <?php foreach ($kampf['partien'] as $partie): ?>
              <?php $this->insert('ctv_partiezeile', ['partie' => $partie, 'spalte' => 'brett', 'mitErgebnissen' => $this->mitErgebnissen, 'hoechstwert' => $this->hoechstwert]); ?>
            <?php endforeach; ?>
          </tbody>
        <?php endforeach; ?>

      <?php else: ?>

        <tbody>
          <?php foreach ($partien as $partie): ?>
            <?php $this->insert('ctv_partiezeile', ['partie' => $partie, 'spalte' => $this->spalte, 'mitErgebnissen' => $this->mitErgebnissen, 'hoechstwert' => $this->hoechstwert]); ?>
          <?php endforeach; ?>
        </tbody>

      <?php endif; ?>
    </table>
  </div>

<?php endforeach; ?>
