<?php

/*
 * Fortschrittstabelle der Mannschaften.
 *
 * Die Spalten sind wählbar; die Spalte „runden" steht für den Block der
 * Rundenzellen. In jeder Zelle stehen ohne Zwischenraum die eigenen
 * Brettpunkte, die Farbe am ersten Brett und der Platz des Gegners —
 * „2½w6" heißt: 2½ Brettpunkte, Weiß am ersten Brett, gegen den
 * Sechstplatzierten. Der Name des Gegners erscheint beim Überfahren.
 *
 * Ein Freilos zeigt seine Punkte und „--", ein ausgeloster, noch nicht
 * gespielter Kampf nur Farbe und Gegner, eine nicht ausgeloste Runde einen
 * Strich.
 */

use Schachbulle\ContaoChesstournamentviewerBundle\Liste\Ausgabe;

?>
<div class="ctv-rollbar">
  <table class="ctv-tabelle ctv-tabelle--fortschritt ctv-tabelle--mannschaftsfortschritt">
    <thead>
      <tr>
        <?php foreach ($this->spalten as $spalte): ?>
          <?php if ('runden' === $spalte['schluessel']): ?>
            <?php foreach ($this->runden as $runde): ?>
              <th scope="col" class="ctv-fortschritt__kopf" title="<?= sprintf(Ausgabe::wort('runde', 'Runde %s'), (int) $runde) ?>"><?= (int) $runde ?></th>
            <?php endforeach; ?>
          <?php else: ?>
            <?php $this->insert('ctv_spaltenkopf', ['spalte' => $spalte, 'sortierbar' => false]); ?>
          <?php endif; ?>
        <?php endforeach; ?>
      </tr>
    </thead>
    <tbody>
      <?php foreach ($this->zeilen as $zeile): ?>
        <tr>
          <?php foreach ($this->spalten as $spalte): ?>
            <?php if ('runden' === $spalte['schluessel']): ?>
              <?php foreach ($this->runden as $runde): ?>
                <?php $zelle = $zeile['runden'][$runde] ?? null; ?>
                <td class="ctv-fortschritt__zelle">
                  <?php if (null === $zelle || $zelle['leer']): ?>
                    &nbsp;
                  <?php elseif ($zelle['nichtAusgelost']): ?>
                    <span class="ctv-fortschritt__frei" title="<?= Ausgabe::wort('nichtAusgelost', 'nicht ausgelost') ?>">&ndash;</span>
                  <?php elseif ($zelle['spielfrei']): ?>
                    <span title="<?= Ausgabe::wort('freilos', 'Freilos') ?>"><span class="ctv-fortschritt__ergebnis"><?= Ausgabe::punkte($zelle['brettpunkte']) ?></span><span class="ctv-fortschritt__frei">--</span></span>
                  <?php else: ?>
                    <span title="<?= Ausgabe::esc($zelle['gegnerName']) ?>"><span class="ctv-fortschritt__ergebnis"><?= Ausgabe::punkte($zelle['brettpunkte']) ?></span><span class="ctv-fortschritt__farbe"><?= Ausgabe::esc($zelle['farbe']) ?></span><?= null === $zelle['gegner'] ? '' : (int) $zelle['gegner'] ?></span>
                  <?php endif; ?>
                </td>
              <?php endforeach; ?>
            <?php else: ?>
              <?php
                $klasse = trim(str_replace('ctv-schmal', '', $spalte['klasse']).' '.Ausgabe::zellklasse($zeile, $spalte['schluessel']));
              ?>
              <td<?= '' === $klasse ? '' : ' class="'.$klasse.'"' ?>><?= Ausgabe::zelle($zeile, $spalte['schluessel'], (bool) ($spalte['ohneTitel'] ?? false)) ?></td>
            <?php endif; ?>
          <?php endforeach; ?>
        </tr>
      <?php endforeach; ?>
    </tbody>
  </table>
</div>
