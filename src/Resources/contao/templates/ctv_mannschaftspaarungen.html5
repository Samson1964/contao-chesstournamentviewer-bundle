<?php

use Schachbulle\ContaoChesstournamentviewerBundle\Liste\Ausgabe;

$wertung = Ausgabe::wertungsname($this->turnier);

?>
<?php foreach ($this->runden as $runde => $kaempfe): ?>

  <h4 class="ctv-runde"><?= Ausgabe::esc(Ausgabe::runde((int) $runde)) ?></h4>

  <div class="ctv-rollbar">
    <table class="ctv-tabelle ctv-tabelle--wettkaempfe">
      <thead>
        <tr>
          <th scope="col" class="ctv-zahl ctv-schmal"><?= Ausgabe::spalte('tisch') ?></th>
          <th scope="col" class="ctv-paarung__seite"><?= Ausgabe::spalte('mannschaft') ?> 1</th>
          <th scope="col" class="ctv-zahl ctv-schmal" title="<?= Ausgabe::spalte('schnitt') ?>"><?= $wertung ?></th>
          <th scope="col" class="ctv-paarung__ergebnis" title="<?= Ausgabe::spalte('ergebnis') ?>"><?= Ausgabe::spalte('ergebnisKurz') ?></th>
          <th scope="col" class="ctv-paarung__seite"><?= Ausgabe::spalte('mannschaft') ?> 2</th>
          <th scope="col" class="ctv-zahl ctv-schmal" title="<?= Ausgabe::spalte('schnitt') ?>"><?= $wertung ?></th>
        </tr>
      </thead>

      <?php foreach ($kaempfe as $nummer => $kampf): ?>
        <tbody class="ctv-gruppe">
          <?php /* Der Wettkampf steht in denselben sechs Spalten wie die
                   Bretter darunter; deshalb braucht die Aufstellung keine
                   eigene Kopfzeile. */ ?>
          <tr class="ctv-wettkampf<?= $kampf['spielfrei'] ? ' ctv-partie--frei' : '' ?>">
            <td class="ctv-zahl"><?= $kampf['spielfrei'] ? '' : Ausgabe::zahl($kampf['tisch'] ?: $nummer + 1) ?></td>
            <td><?= Ausgabe::esc($kampf['heimName']) ?></td>
            <td class="ctv-zahl"><?= Ausgabe::zahl($kampf['schnittHeim']) ?></td>
            <td class="ctv-paarung__ergebnis ctv-punkte">
              <?= $kampf['gespielt'] ? Ausgabe::punkte($kampf['brettpunkteHeim']).':'.Ausgabe::punkte($kampf['brettpunkteGast']) : '&ndash;' ?>
            </td>
            <td>
              <?php if ($kampf['spielfrei']): ?>
                <em><?= Ausgabe::wort('freilos', 'Freilos') ?></em>
              <?php else: ?>
                <?= Ausgabe::esc($kampf['gastName']) ?>
              <?php endif; ?>
            </td>
            <td class="ctv-zahl"><?= Ausgabe::zahl($kampf['schnittGast']) ?></td>
          </tr>

          <?php if ($this->mitSpielern): ?>
            <?php foreach ($kampf['partien'] as $partie): ?>
              <?php $this->insert('ctv_partiezeile', ['partie' => $partie, 'spalte' => 'brett', 'mitErgebnissen' => true]); ?>
            <?php endforeach; ?>
          <?php endif; ?>
        </tbody>
      <?php endforeach; ?>
    </table>
  </div>

<?php endforeach; ?>
