<?php

use Schachbulle\ContaoChesstournamentviewerBundle\Liste\Ausgabe;

$gruppiert = (bool) $this->gruppen;
$spalten = $this->spalten;

?>
<div class="ctv-rollbar">
  <table class="ctv-tabelle ctv-tabelle--rangliste"<?= $this->sortierbar ? ' data-ctv-sortierbar' : '' ?>>
    <thead>
      <tr>
        <?php foreach ($spalten as $spalte): ?>
          <?php $this->insert('ctv_spaltenkopf', ['spalte' => $spalte, 'sortierbar' => $this->sortierbar]); ?>
        <?php endforeach; ?>
      </tr>
    </thead>

    <?php if ($gruppiert): ?>

      <?php foreach ($this->gruppen as $gruppe): ?>
        <tbody class="ctv-gruppe">
          <tr class="ctv-gruppe__kopf">
            <th scope="colgroup" colspan="<?= count($spalten) ?>">
              <?php if ($gruppe['nummer'] > 0): ?>
                <span class="ctv-gruppe__nummer"><?= (int) $gruppe['startnummer'] ?></span>
                <?= Ausgabe::esc($gruppe['name']) ?>
              <?php else: ?>
                <?= Ausgabe::wort('ohneMannschaft', 'Ohne Mannschaft') ?>
              <?php endif; ?>
            </th>
          </tr>
          <?php foreach ($gruppe['spieler'] as $spieler): ?>
            <?php $this->insert('ctv_spaltenzeile', ['zeile' => $spieler, 'spalten' => $spalten]); ?>
          <?php endforeach; ?>
        </tbody>
      <?php endforeach; ?>

    <?php else: ?>

      <tbody>
        <?php foreach ($this->spieler as $spieler): ?>
          <?php $this->insert('ctv_spaltenzeile', ['zeile' => $spieler, 'spalten' => $spalten]); ?>
        <?php endforeach; ?>
      </tbody>

    <?php endif; ?>
  </table>
</div>
