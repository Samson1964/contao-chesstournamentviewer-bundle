<?php

use Schachbulle\ContaoChesstournamentviewerBundle\Liste\Ausgabe;

?>
<div class="ctv-rollbar">
  <table class="ctv-tabelle ctv-tabelle--kreuz">
    <thead>
      <tr>
        <th scope="col" class="ctv-zahl ctv-schmal" title="<?= Ausgabe::spalte('platz') ?>"><?= Ausgabe::spalte('platzKurz') ?></th>
        <th scope="col"><?= Ausgabe::spalte('name') ?></th>
        <th scope="col" class="ctv-zahl ctv-schmal"><?= Ausgabe::spalte('twz') ?></th>
        <th scope="col" class="ctv-zahl ctv-schmal" title="<?= Ausgabe::spalte('punkte') ?>"><?= Ausgabe::spalte('punkteKurz') ?></th>
        <?php if ($this->feinwertung1): ?>
          <th scope="col" class="ctv-zahl ctv-schmal" title="<?= Ausgabe::esc($this->feinwertung1['titel']) ?>"><?= Ausgabe::esc($this->feinwertung1['name']) ?></th>
        <?php endif; ?>
        <?php if ($this->feinwertung2): ?>
          <th scope="col" class="ctv-zahl ctv-schmal" title="<?= Ausgabe::esc($this->feinwertung2['titel']) ?>"><?= Ausgabe::esc($this->feinwertung2['name']) ?></th>
        <?php endif; ?>
        <?php foreach ($this->spieler as $nummer => $unused): ?>
          <th scope="col" class="ctv-kreuz__feld ctv-kreuz__kopf"><?= $nummer + 1 ?></th>
        <?php endforeach; ?>
      </tr>
    </thead>
    <tbody>
      <?php foreach ($this->spieler as $index => $spieler): ?>
        <tr>
          <td class="ctv-zahl"><?= $index + 1 ?></td>
          <td class="ctv-kreuz__name"><?= Ausgabe::esc(Ausgabe::name($spieler)) ?></td>
          <td class="ctv-zahl"><?= Ausgabe::zahl($spieler['twz']) ?></td>
          <td class="ctv-zahl ctv-punkte"><?= Ausgabe::punkte($spieler['punkte']) ?></td>
          <?php if ($this->feinwertung1): ?>
            <td class="ctv-zahl"><?= Ausgabe::punkte($spieler['feinwertung1']) ?></td>
          <?php endif; ?>
          <?php if ($this->feinwertung2): ?>
            <td class="ctv-zahl"><?= Ausgabe::punkte($spieler['feinwertung2']) ?></td>
          <?php endif; ?>
          <?php foreach ($this->zeilen[$index] as $spalte => $symbol): ?>
            <?php if ('**' === $symbol): ?>
              <?php /* Blindfeld: der Spieler trifft nicht auf sich selbst. Der
                       König macht das Feld auf den ersten Blick erkennbar; für
                       Vorleseprogramme bleibt er verborgen. */ ?>
              <td class="ctv-kreuz__feld ctv-kreuz__diagonale"><span aria-hidden="true">&#9818;</span></td>
            <?php else: ?>
              <td class="ctv-kreuz__feld"><?= Ausgabe::esc($symbol) ?></td>
            <?php endif; ?>
          <?php endforeach; ?>
        </tr>
      <?php endforeach; ?>
    </tbody>
  </table>
</div>
