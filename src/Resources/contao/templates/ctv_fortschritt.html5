<?php

use Schachbulle\ContaoChesstournamentviewerBundle\Liste\Ausgabe;

?>
<div class="ctv-rollbar">
  <table class="ctv-tabelle ctv-tabelle--fortschritt">
    <thead>
      <tr>
        <th scope="col" class="ctv-zahl"><?= Ausgabe::spalte('platz') ?></th>
        <th scope="col"><?= Ausgabe::spalte('name') ?></th>
        <th scope="col" class="ctv-zahl"><?= Ausgabe::spalte('twz') ?></th>
        <?php foreach ($this->runden as $runde): ?>
          <th scope="col" class="ctv-zahl"><?= (int) $runde ?>.</th>
        <?php endforeach; ?>
        <th scope="col" class="ctv-zahl"><?= Ausgabe::spalte('punkte') ?></th>
      </tr>
    </thead>
    <tbody>
      <?php foreach ($this->zeilen as $zeile): ?>
        <tr>
          <td class="ctv-zahl"><?= (int) $zeile['spieler']['platz'] ?></td>
          <td><?= Ausgabe::esc(Ausgabe::name($zeile['spieler'])) ?></td>
          <td class="ctv-zahl"><?= Ausgabe::zahl($zeile['spieler']['twz']) ?></td>
          <?php foreach ($this->runden as $runde): ?>
            <?php $zelle = $zeile['runden'][$runde] ?? null; ?>
            <td class="ctv-zahl ctv-fortschritt__zelle">
              <?php if (null === $zelle || $zelle['leer']): ?>
                &nbsp;
              <?php elseif ($zelle['spielfrei']): ?>
                <span class="ctv-fortschritt__frei" title="<?= Ausgabe::wort('spielfrei', 'spielfrei') ?>">&mdash;</span>
                <span class="ctv-fortschritt__stand"><?= Ausgabe::punkte($zelle['stand']) ?></span>
              <?php else: ?>
                <span class="ctv-fortschritt__gegner"<?php if ($zelle['gegnerName']): ?> title="<?= Ausgabe::esc($zelle['gegnerName']) ?>"<?php endif; ?>><?= (int) $zelle['gegner'] ?></span><span class="ctv-fortschritt__farbe ctv-farbe--<?= $zelle['farbe'] ?: 'ohne' ?>"><?= Ausgabe::esc($zelle['farbe']) ?></span><span class="ctv-fortschritt__ergebnis"><?= Ausgabe::punkte($zelle['ergebnis']) ?></span>
                <span class="ctv-fortschritt__stand"><?= Ausgabe::punkte($zelle['stand']) ?></span>
              <?php endif; ?>
            </td>
          <?php endforeach; ?>
          <td class="ctv-zahl ctv-punkte"><?= Ausgabe::punkte($zeile['spieler']['punkte']) ?></td>
        </tr>
      <?php endforeach; ?>
    </tbody>
  </table>
</div>
