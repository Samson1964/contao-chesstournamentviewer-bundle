<?php

/*
 * Mannschaftstabelle.
 *
 * Die Spalten sind wählbar wie bei Teilnehmerliste und Rangliste; Kopf und
 * Zeilen kommen deshalb aus denselben Templates. Ohne eigene Auswahl
 * erscheinen Platz, Mannschaft, Wettkämpfe, Bilanz, Freilose — sofern es
 * welche gibt —, Mannschafts- und Brettpunkte.
 */

?>
<div class="ctv-rollbar">
  <table class="ctv-tabelle ctv-tabelle--mannschaftsrangliste"<?= $this->sortierbar ? ' data-ctv-sortierbar' : '' ?>>
    <thead>
      <tr>
        <?php foreach ($this->spalten as $spalte): ?>
          <?php $this->insert('ctv_spaltenkopf', ['spalte' => $spalte, 'sortierbar' => $this->sortierbar]); ?>
        <?php endforeach; ?>
      </tr>
    </thead>
    <tbody>
      <?php foreach ($this->mannschaften as $zeile): ?>
        <?php $this->insert('ctv_spaltenzeile', ['zeile' => $zeile, 'spalten' => $this->spalten]); ?>
      <?php endforeach; ?>
    </tbody>
  </table>
</div>
